# Folder screenshot dan folder Excel Google Drive for Desktop.
SCREENSHOT_FOLDER=%USERPROFILE%\OneDrive\Pictures\Screenshots
DRIVE_REPORT_FOLDER=G:\My Drive\Latihan OPD Automation\SEPTEMBER
BACKUP_FOLDER=backups

# Pembacaan tanggal dan penempatan gambar.
TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe
MAX_IMAGE_WIDTH_PX=1220
MAX_IMAGE_HEIGHT_PX=330
CROP_SPEED_SUMMARY=true
ALLOW_REPLACE_EXISTING=false
TIMEZONE_OFFSET_HOURS=7

# console | n8n | whatsapp_cloud
NOTIFICATION_MODE=console

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_API_VERSION=v23.0
